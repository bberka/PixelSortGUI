{
	"name": "drift",
	"private": true,
	"description": "Web GUI editor for glitch art and pixel sorting of still photos.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/bberka/drift"
	},
	"homepage": "https://drift.bbay.dev",
	"bugs": {
		"url": "https://github.com/bberka/drift/issues"
	},
	"type": "module",
	"engines": {
		"node": "^22.18.0 || >=24.11.0"
	},
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"prepare": "vp hooks enable --hooks-dir .hooks",
		"build": "vp build",
		"check:pages-output": "node scripts/check-pages-output.ts",
		"test": "vp test run",
		"test:watch": "vp test",
		"typecheck": "tsgo -b",
		"lint": "xo",
		"lint:fix": "xo --fix",
		"format": "xo --fix",
		"check": "xo && tsgo -b && vp test run",
		"version:next": "node scripts/release-version.ts next",
		"test:e2e": "playwright test",
		"test:perf": "playwright test --config playwright.perf.config.ts --workers=1",
		"check:a11y": "playwright test --grep @a11y",
		"proof:sheet": "node scripts/proof-sheet.ts",
		"evidence": "node scripts/publish-evidence.ts",
		"browser:install": "playwright install chromium firefox",
		"check:agent-context": "node scripts/agent-context.ts",
		"agent-context:write": "node scripts/agent-context.ts --write",
		"spike:s3": "node spikes/s3/run.ts",
		"bench:s1": "node scripts/spike-s1-bench.ts",
		"bench": "node scripts/bench.ts",
		"golden:update": "node scripts/golden-update.ts",
		"gen:notices": "node scripts/gen-notices.ts",
		"check:notices": "node scripts/gen-notices.ts --check",
		"gen:changelog": "node scripts/gen-changelog.ts",
		"clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true }); require('node:fs').rmSync('node_modules/.tmp', { recursive: true, force: true })\""
	},
	"dependencies": {
		"@radix-ui/react-slot": "^1.5.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.72.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^2.6.1",
		"utif2": "^4.1.0",
		"workbox-window": "^7.4.1",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"@vitejs/plugin-react": "^6.3.0",
		"eslint-config-xo-react": "^0.32.0",
		"fake-indexeddb": "^6.2.8",
		"fast-check": "^4.11.0",
		"fast-png": "^8.0.0",
		"happy-dom": "^21.0.4",
		"tailwindcss": "4.3.5",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plugin-pwa": "^2.0.0",
		"vite-plus": "catalog:",
		"xo": "^5.0.1"
	}
}
