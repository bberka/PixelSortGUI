{
	"extends": "./base.json",
	"compilerOptions": {
		"tsBuildInfoFile": "../node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"erasableSyntaxOnly": true,
		"lib": ["ES2024"],
		"types": ["node"]
	},
	"include": [
		"../vite.config.ts",
		"../xo.config.ts",
		"../playwright.config.ts",
		"../playwright.perf.config.ts",
		"../scripts/**/*.ts"
	],
	"exclude": ["../scripts/**/*.test.ts"]
}
